{
  "name": "noblenest-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "check": "node --check src/config.js && node --check src/app.js && node --check src/server.js && node --check scripts/check-db.js && node --check test/app.test.js",
    "test": "node --test",
    "check:db": "node --env-file-if-exists=.env scripts/check-db.js"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mongodb": "7.8.0"
  }
}
