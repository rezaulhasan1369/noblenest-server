PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
# Required in production; replace placeholders locally, never commit credentials.
MONGODB_URI=
MONGODB_DB_NAME=
# Optional API authentication. Configure all three together; no signing secret here.
AUTH_JWT_ISSUER=http://127.0.0.1:3000
AUTH_JWT_AUDIENCE=http://127.0.0.1:5001
AUTH_JWKS_URL=http://127.0.0.1:3000/api/auth/jwks
